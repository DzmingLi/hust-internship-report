// ruled: false 可关闭横线，适合含图片、表格或多种字号的内容。
#let _dated-diary(date, ruled: true, body) = {
  pagebreak(weak: true)
  set page(
    margin: (left: 15mm, right: 15mm, top: 32mm, bottom: 29mm),
    footer-descent: 14mm,
    background: _diary-paper(date: date, ruled: ruled),
  )
  set text(font: ("Times New Roman", "SimSun"), size: 12pt, top-edge: 0.8em, bottom-edge: 0.2em)
  set par(justify: true, first-line-indent: (amount: 2em, all: true),
    leading: 9.62mm - 9.6pt, spacing: 9.62mm - 9.6pt)
  // 隐形零宽字符使空白日记也实际生成一页。
  context {
    if measure(body).height == 0pt { text("\u{200b}") } else { body }
  }
  pagebreak(weak: true)
}

#let _period = state("hust-notebook-period", none)
#let _day = counter("hust-notebook-day")

// 每个块对应周一至周五的一天，周六、周日不分配日记页。
#let diary-entry(ruled: true, body) = {
  _day.step()
  context {
    let period = _period.get()
    assert(period != none, message: "diary-entry 必须在 internship-notebook 中使用")
    let index = _day.get().first() - 1
    assert(index < period.dates.len(), message: "日记条目数超出实习起止日期内的工作日数（不含周六、周日）")
    let date = period.dates.at(index)
    _dated-diary(date.display("[year] 年 [month] 月 [day] 日"), ruled: ruled, body)
  }
}

#let internship-notebook(
  body,
  start-date: datetime(year: 2026, month: 5, day: 26),
  end-date: datetime(year: 2026, month: 7, day: 17),
  department: none, major-class: none, student-name: none, student-id: none,
  instructor: none, internship-organization: none,
) = {
  assert(start-date <= end-date, message: "实习结束日期不能早于开始日期")
  let dates = ()
  let date = start-date
  while date <= end-date {
    if date.weekday() <= 5 { dates.push(date) }
    date += duration(days: 1)
  }
  _period.update((dates: dates))
  _day.update(0)
  set page(width: 184.06mm, height: 260mm,
    margin: (left: 22.5mm, right: 24.5mm, top: 20mm, bottom: 24mm),
    footer: none)
  set text(lang: "zh", font: ("Times New Roman", "SimSun"), size: 12pt)
  notebook-cover(department, major-class, student-name, student-id,
    instructor, internship-organization,
    [#start-date.display("[year] 年 [month] 月 [day] 日")～#end-date.display("[year] 年 [month] 月 [day] 日")])
  pagebreak(to: "odd")
  counter(page).update(1)
  set page(margin: (left: 22.5mm, right: 24.5mm, top: 23mm, bottom: 24mm),
    footer-descent: 9mm, footer: align(center, notebook-page-number()))
  notebook-notices()
  pagebreak()
  body
  pagebreak(weak: true)
  set page(
    margin: (left: 15mm, right: 15mm, top: 32mm, bottom: 29mm),
    footer-descent: 14mm,
    background: _diary-paper(),
  )
  // 封面及其内侧占 2 页，内页从奇数物理页开始，封底也从奇数页开始。
  pagebreak(weak: true, to: "odd")
  page(header: none, footer: none, background: none, foreground: none)[]
}
